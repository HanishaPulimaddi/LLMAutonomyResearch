# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# "mock" makes no API calls (default). "groq" makes real Groq API calls.
LLM_MODE=mock

# Required when LLM_MODE=groq.
GROQ_API_KEY=
# Groq model ID, from https://console.groq.com/docs/models (the reported run used openai/gpt-oss-20b).
GROQ_MODEL=
